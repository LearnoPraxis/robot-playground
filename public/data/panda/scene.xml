<mujoco model="panda scene">
  <include file="panda.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <material name="groundplane" rgba="0.15 0.2 0.25 1" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 0" size="2 2 0.05" type="plane" material="groundplane"/>
    <!-- 小球（free body，可被推动） -->
    <body name="ball" pos="0.5 0 0.04">
      <freejoint/>
      <geom name="ball_geom" type="sphere" size="0.04" rgba="0.13 0.55 0.13 1" mass="0.1"/>
    </body>
    <!-- 抓取物（free body，可被抓取）
         尺寸/位置选型说明（2026-10-11 依据离线回放与几何实测）：
         - 夹爪总开口 8cm，但**指垫在内侧面**，指垫间距 = 指间距 - 1.1cm，
           完全张开时仅 6.9cm。物体宽 3.5cm 时单侧夹持行程 1.70cm（可用）。
         - 位置从 (0.5, 0.30) 移到 **(0.5, 0.22)**：更靠近基座，
           抬臂时手臂的横扫更垂直，减少"抬起瞬间把物体蹭倒"的问题。
         - 高度 10cm 是为了容忍夹爪倾斜带来的两指高度差（约 3.8cm）。 -->
    <body name="cube" pos="0.5 0.22 0.05">
      <freejoint/>
      <geom name="cube_geom" type="box" size="0.0175 0.0175 0.05" rgba="0.8 0.4 0.2 1" mass="0.05"
            friction="1.0 0.005 0.0001"/>
    </body>
    <!-- 货架（static body，放置目标）
         2026-10-11：整体抬高。原因：原来顶面在 z=0.4、四条腿只到 0.4，
         平台**下面几乎没有净空**，放置时手臂/物体在接近途中会先撞到平台，
         表现为"每次都想把方块放到架子下方"。现在顶面 0.55 m，
         腿高 0.55 m，平台下方有 55cm 净空，放置路径不再被挡。
         物体高 10cm → 放到架上后中心 0.60 m、顶面 0.65 m。 -->
    <body name="shelf" pos="0 0.5 0">
      <geom name="shelf_top" type="box" size="0.15 0.15 0.005" pos="0 0 0.55" rgba="0.3 0.3 0.3 1"/>
      <geom name="shelf_leg1" type="box" size="0.01 0.01 0.275" pos="0.14 0.14 0.275" rgba="0.2 0.2 0.2 1"/>
      <geom name="shelf_leg2" type="box" size="0.01 0.01 0.275" pos="-0.14 0.14 0.275" rgba="0.2 0.2 0.2 1"/>
      <geom name="shelf_leg3" type="box" size="0.01 0.01 0.275" pos="0.14 -0.14 0.275" rgba="0.2 0.2 0.2 1"/>
      <geom name="shelf_leg4" type="box" size="0.01 0.01 0.275" pos="-0.14 -0.14 0.275" rgba="0.2 0.2 0.2 1"/>
    </body>
  </worldbody>
</mujoco>

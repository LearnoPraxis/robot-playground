<mujoco model="panda scene">
  <include file="panda.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <material name="groundplane" rgba="0.15 0.2 0.25 1" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 0" size="2 2 0.05" type="plane" material="groundplane"/>
    <!-- 小球（free body，可被推动） -->
    <body name="ball" pos="0.5 0 0.04">
      <freejoint/>
      <geom name="ball_geom" type="sphere" size="0.04" rgba="0.13 0.55 0.13 1" mass="0.1"/>
    </body>
    <!-- 抓取物（free body，可被抓取）
         尺寸选型说明（2026-10-11 实测修订）：
         - 夹爪**总开口 8cm**（两指各 4cm 行程，已用 actuator8 实测确认），
           但**指垫在内侧面**，指垫间距 = 指间距 - 1.1cm。
         - 若物体宽度接近 8cm，指垫几乎不用移动就能碰到 → 只有极小的夹持行程，
           实际是"碰一下"而不是"夹住"（6cm 方箱每指只有约 5mm 行程，实测失败）。
         - 因此宽度取 3.5cm：指垫需移动约 1.9cm，有明确夹持行程，
           同时物体(±1.75cm)离指垫完全张开位置(±3.45cm)仍有充足间隙。
         - 高度取 10cm：夹爪倾斜会让两指高度差约 1.9~3.8cm，
           物体越高，这个高度差越不致命（这是 5cm 立方体失败的原因）。 -->
    <body name="cube" pos="0.5 0.3 0.05">
      <freejoint/>
      <geom name="cube_geom" type="box" size="0.0175 0.0175 0.05" rgba="0.8 0.4 0.2 1" mass="0.05"/>
    </body>
    <!-- 货架（static body，放置目标） -->
    <body name="shelf" pos="0 0.5 0">
      <geom name="shelf_top" type="box" size="0.15 0.15 0.005" pos="0 0 0.4" rgba="0.3 0.3 0.3 1"/>
      <geom name="shelf_leg1" type="box" size="0.01 0.01 0.2" pos="0.14 0.14 0.2" rgba="0.2 0.2 0.2 1"/>
      <geom name="shelf_leg2" type="box" size="0.01 0.01 0.2" pos="-0.14 0.14 0.2" rgba="0.2 0.2 0.2 1"/>
      <geom name="shelf_leg3" type="box" size="0.01 0.01 0.2" pos="0.14 -0.14 0.2" rgba="0.2 0.2 0.2 1"/>
      <geom name="shelf_leg4" type="box" size="0.01 0.01 0.2" pos="-0.14 -0.14 0.2" rgba="0.2 0.2 0.2 1"/>
    </body>
  </worldbody>
</mujoco>
